# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# Playwright 결과물
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# 산 교재 자료: 오디오·원본은 git에 넣지 않는다 (docs/standing-rules.md "저작권")
/media/
/textbook-src/
# 교재에서 뽑은 글·자막: 공개 저장소라 git 밖에 둔다(docs/standing-rules.md "저작권")
# textbook-analysis(예문 낱말 분석)·transcripts-before-retry(옛 자막) 같은 딸린 폴더도 함께 막는다
/content/textbook*/
/content/transcripts*/
# 노래 가사·세션 분석(상업 음원의 가사, docs/song-analysis.md)
/content/songs/

# 서브에이전트 작업 트리·화면 확인 스크린샷
/.claude/worktrees/
/.claude/screenshots/

# 서버에서 받은 학습 기록 DB
/data/*.db
/data/*.db-*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 학습자 점검 보고서와 스크린샷(교재 글이 찍히거나 인용된다, 로컬에만 둔다)
docs/audit/
